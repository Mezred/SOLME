# ─────────────────────────────────────────────────────────────────────────────
# SOLME environment configuration — copy to .env.local and fill in.
# Every value below is a PLACEHOLDER. Never commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none are used.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used in emails and the sitemap)
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Production: any PostgreSQL 15+ (Neon, Supabase, RDS, Railway…). Must allow CREATE ROLE
# (row-level-security role `nexalpha_app`). Leave empty for local dev → embedded PGlite.
DATABASE_URL=
# DATABASE_POOL_MAX=10
# Local embedded database directory (dev only). Prefer a folder OUTSIDE the project: the database writes
# constantly and `next dev` reloads the page on every write to a watched folder.
# PGLITE_DIR=C:/Users/you/.nexalpha/pglite

# ── Data mode & background work ─────────────────────────────────────────────
# true = serve the clearly-labelled synthetic demo dataset instead of live providers
DEMO_MODE=false
# Run the job scheduler inside the web server (default true when DATABASE_URL is empty)
# WORKER_IN_PROCESS=false
# Secret for /api/cron/tick (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=replace-with-a-long-random-string

# ── Auth ────────────────────────────────────────────────────────────────────
SESSION_DAYS=30
# The account registering with this email becomes an administrator (audited)
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# USD per million tokens — used only for cost tracking in the admin panel
AI_INPUT_PRICE_PER_MTOK=4
AI_OUTPUT_PRICE_PER_MTOK=20

# ── Billing (crypto: USDC / SOL on Solana via Solana Pay) ───────────────────
# Your own Solana wallet address (public key) that receives subscription payments. Needs HELIUS_API_KEY to
# confirm payments on-chain. Use a wallet you control; never put a private key or seed phrase here.
SOLANA_PAY_RECIPIENT=

# ── Sell simulation for alert risk checks (Jupiter, free tier, no key) ──────────
# JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=SOLME <alerts@your-domain.com>

# ── Telegram alerts ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Blockchain data providers ───────────────────────────────────────────────
# DexScreener, GeckoTerminal and GoPlus work without keys.
HELIUS_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# ── Trading link (optional) ────────────────────────────────────────────────
# Your GMGN referral code; "Trade on GMGN" buttons append it (gmgn.ai/{chain}/token/{CODE}_{token}).
GMGN_REFERRAL_CODE=

# ── Seeding (dev/staging only) ──────────────────────────────────────────────
# SEED_PASSWORD=choose-a-dev-password
