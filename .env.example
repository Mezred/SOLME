# ─────────────────────────────────────────────────────────────────────────────
# NEXALPHA environment configuration — copy to .env.local and fill in.
# Every value below is a PLACEHOLDER. Never commit real secrets.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none are used.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used in emails, Stripe redirects, sitemap)
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Production: any PostgreSQL 15+ (Neon, Supabase, RDS, Railway…). Must allow CREATE ROLE
# (row-level-security role `nexalpha_app`). Leave empty for local dev → embedded PGlite.
DATABASE_URL=
# DATABASE_POOL_MAX=10
# Local embedded database directory (dev only)
# PGLITE_DIR=.data/pglite

# ── Data mode & background work ─────────────────────────────────────────────
# true = serve the clearly-labelled synthetic demo dataset instead of live providers
DEMO_MODE=false
# Run the job scheduler inside the web server (default true when DATABASE_URL is empty)
# WORKER_IN_PROCESS=false
# Secret for /api/cron/tick (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=replace-with-a-long-random-string

# ── Auth ────────────────────────────────────────────────────────────────────
SESSION_DAYS=30
# The account registering with this email becomes an administrator (audited)
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# USD per million tokens — used only for cost tracking in the admin panel
AI_INPUT_PRICE_PER_MTOK=4
AI_OUTPUT_PRICE_PER_MTOK=20

# ── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs are configured in Admin → Pricing (stored in the database)

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=NEXALPHA <alerts@your-domain.com>

# ── Telegram alerts ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Blockchain data providers ───────────────────────────────────────────────
# DexScreener, GeckoTerminal and GoPlus work without keys.
HELIUS_API_KEY=
# HELIUS_API_BASE=https://api-mainnet.helius-rpc.com
ALCHEMY_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# ── Seeding (dev/staging only) ──────────────────────────────────────────────
# SEED_PASSWORD=choose-a-dev-password
